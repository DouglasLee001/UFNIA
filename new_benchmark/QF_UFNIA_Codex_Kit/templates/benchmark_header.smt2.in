; TEMPLATE ONLY. Replace every placeholder; do not count as a benchmark.
(set-info :smt-lib-version 2.6)
(set-logic QF_UFNIA)
(set-info :source |
Generated by: <actual generator authors>
Generated on: <actual generation date YYYY-MM-DD>
Generator: <tool name and complete commit>
Application: <real application, source file, property and bounded scope>
Publications: <SOURCES.md IDs and original URLs/DOIs>
Time limit: <actual application/benchmark limit in seconds>
Provenance: <metadata relative path>
Query kind: <counterexample / witness / reachability / other>
Classification: <faithful_export / application_derived / source_mutant>
Novelty: <checked snapshot and method, or pending>
|)
(set-info :license "<actual license; do not assume CC BY>")
(set-info :category "<industrial / crafted / random, per actual origin>")
; Single-query template: change unknown only after actual validation.
(set-info :status unknown)
; <all required declarations and ordinary nonrecursive definitions>
; <all active assertions including the property violation condition>
; <current check-sat-assuming assumptions asserted here if snapshotting>
(check-sat)
(exit)

; For incremental files, follow the selected SMT-LIB release requirements:
; record one status for each query in its correct position; preserve scope.
